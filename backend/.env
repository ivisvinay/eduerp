# .env file for LLM Backend
# Copy this to your backend folder and update values

# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# Open WebUI Configuration
OPEN_WEBUI_URL=https://chat.ivislabs.in
OPEN_WEBUI_API_KEY=sk-bf725748416143d88b7ea444d68f0c90

# LLM Service Configuration
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT=60
PREFERRED_MODEL=llama3.2:latest

# Cache Configuration
CACHE_TTL=300
CACHE_CHECK_PERIOD=600

# Logging Configuration
LOG_LEVEL=info
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5

# Security Configuration (Optional)
JWT_SECRET=your-jwt-secret-here
API_KEY=your-api-key-for-frontend

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Production Overrides (uncomment for production)
# NODE_ENV=production
# PORT=5001
# FRONTEND_URL=https://your-frontend-domain.com
# LOG_LEVEL=warn
# CORS_ORIGIN=https://your-frontend-domain.com