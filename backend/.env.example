# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_schools_erp
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/agentic_schools_erp

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# AI Service Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3

# Local LLM Configuration (Optional)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2:7b
USE_LOCAL_LLM=true
LLM_FALLBACK_TO_OPENAI=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Agentic Schools ERP

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# AI Assistant Configuration
AI_ASSISTANT_NAME=EduCare AI Assistant
AI_RESPONSE_TIMEOUT=30000
AI_CACHE_TTL=3600
AI_MAX_CONTEXT_LENGTH=4000

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true
NOTIFICATION_BATCH_SIZE=50

# Analytics Configuration
ANALYTICS_RETENTION_DAYS=365
ENABLE_REAL_TIME_ANALYTICS=true
ANALYTICS_BATCH_INTERVAL=300000

# Backup Configuration
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your_backup_bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_VOICE_FEATURES=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_REAL_TIME_CHAT=true
ENABLE_MOBILE_PUSH=false

# Performance Configuration
REQUEST_TIMEOUT=30000
DB_POOL_MIN=2
DB_POOL_MAX=10
REDIS_POOL_SIZE=10
CACHE_TTL=300

# Development Configuration
DEBUG=agentic:*
ENABLE_SWAGGER=true
ENABLE_CORS=true
TRUST_PROXY=true

# Production Configuration (Override in production)
# NODE_ENV=production
# CLIENT_URL=https://your-frontend-domain.com
# API_URL=https://your-api-domain.com
# LOG_LEVEL=warn
# ENABLE_SWAGGER=false